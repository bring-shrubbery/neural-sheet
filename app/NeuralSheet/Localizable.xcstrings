{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” already exists. Do you want to replace it?" : {
      "comment" : "Alert title: Export Stems… would overwrite a file, AppKit's own wording",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits vorhanden. Möchtest du die Datei ersetzen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya existe. ¿Quieres reemplazarlo?"
          }
        }
      }
    },
    "\"%@\" could not be loaded as a SoundFont (.sf2) or DLS (.dls) file. NeuralSheet is using the system's General MIDI sounds instead." : {
      "comment" : "Alert body: a sound bank file was refused",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als SoundFont- (.sf2) oder DLS-Datei (.dls) geladen werden. NeuralSheet verwendet stattdessen die General-MIDI-Klänge des Systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido cargar “%@” como archivo SoundFont (.sf2) o DLS (.dls). NeuralSheet usa en su lugar los sonidos General MIDI del sistema."
          }
        }
      }
    },
    "%@ — %lld notes" : {
      "comment" : "Edit → Versions: a version and its note count, e.g. \"Version 2 — 412 notes\"",
      "localizations" : {
        "de" : {
