            "value" : "%@ dB"
          }
        }
      }
    },
    "%@ GB" : {
      "comment" : "A file size in gigabytes, e.g. \"2.7 GB\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ GB"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ GB"
          }
        }
      }
    },
    "%@ is for another version of NeuralSheet. Delete it from the models folder, then download it again" : {
      "comment" : "The reason in a failed transcription's alert: the model file is from another release",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gehört zu einer anderen Version von NeuralSheet. Lösche die Datei aus dem Modellordner und lade sie erneut herunter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es de otra versión de NeuralSheet. Elimínalo de la carpeta de modelos y vuelve a descargarlo"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Accessibility value: the playhead's time of the take's length, e.g. \"0:12.34 of 3:05.00\"\nSettings → Model: a download's progress, e.g. \"618 MB of 2.7 GB\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ von %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@"
          }
        }
      }
    },
    "%@ rest, %@, bar %lld" : {
      "comment" : "VoiceOver: a rest in the score, e.g. \"quarter rest, Piano, bar 5\"; the first value is a note value such as \"quarter\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause (%1$@), %2$@, Takt %3$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "silencio de %1$@, %2$@, compás %3$lld"
          }
        }
      }
    },
    "%@ s" : {
      "comment" : "Status bar: the take's length in seconds",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s"
          }
        }
      }
    },
    "%@ to %@" : {
      "comment" : "VoiceOver: the keys on show, lowest to highest, e.g. \"C2 to C6\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bis %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@"
          }
        }
      }
    },
    "%@, %@ note, %@, bar %lld" : {
      "comment" : "VoiceOver: a note or chord in the score, e.g. \"E4 G4, quarter note, Piano, bar 5\"; the second value is a note value such as \"quarter\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, %3$@, Takt %4$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, %3$@, compás %4$lld"
          }
        }
      }
    },
    "%@, %@, bar %lld beat %lld, %@" : {
      "comment" : "VoiceOver: a note on the piano roll; pitch, instrument, where it starts, how long it is, e.g. \"C4, Piano, bar 3 beat 2, half a beat\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, Takt %3$lld Schlag %4$lld, %5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, compás %3$lld pulso %4$lld, %5$@"
          }
        }
      }
    },
    "%@, bar %lld beat %lld" : {
      "comment" : "VoiceOver: a chord symbol in the chord lane, e.g. \"Am7, bar 3 beat 1\"\nVoiceOver: the ruler's value, the playhead's time then its bar and beat",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, Takt %2$lld Schlag %3$lld"
