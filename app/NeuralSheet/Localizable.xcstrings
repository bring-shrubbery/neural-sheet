    "A file with the same name already exists in “%@”. Replacing it will overwrite its current contents." : {
      "comment" : "Alert body: Export Stems… would overwrite a file",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Ordner „%@“ ist bereits eine Datei mit diesem Namen vorhanden. Beim Ersetzen wird ihr aktueller Inhalt überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo con el mismo nombre en “%@”. Si lo reemplazas, se sobrescribirá su contenido actual."
          }
        }
      }
    },
    "A MIDI file has 16 channels, one of which is reserved for drums." : {
      "comment" : "Shown in File → Export MIDI…'s sheet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine MIDI-Datei hat 16 Kanäle, einer davon ist für Schlagzeug reserviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo MIDI tiene 16 canales, uno de ellos reservado para la batería."
          }
        }
      }
    },
