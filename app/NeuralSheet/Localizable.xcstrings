{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" could not be loaded as a SoundFont (.sf2) or DLS (.dls) file. NeuralSheet is using the system's General MIDI sounds instead." : {
      "comment" : "Alert body: a sound bank file was refused"
    },
    "%@ (%lld skipped)" : {
      "comment" : "Batch window: a done file, some of whose outputs existed already"
    },
    "%@ GB" : {
      "comment" : "A file size in gigabytes, e.g. \"2.7 GB\""
    },
    "%@ beats" : {
      "comment" : "VoiceOver: a note's length in beats, to a tenth, e.g. \"1.5 beats\""
    },
    "%@ dB" : {
      "comment" : "Accessibility value: a level in decibels, e.g. \"-6.0 dB\""
    },
    "%@ is for another version of NeuralSheet. Delete it from the models folder, then download it again" : {
      "comment" : "The reason in a failed transcription's alert: the model file is from another release"
    },
    "%@ of %@" : {
      "comment" : "Accessibility value: the playhead's time of the take's length, e.g. \"0:12.34 of 3:05.00\" / Settings → Model: a download's progress, e.g. \"618 MB of 2.7 GB\""
    },
    "%@ rest, %@, bar %lld" : {
      "comment" : "VoiceOver: a rest in the score, e.g. \"quarter rest, Piano, bar 5\"; the first value is a note value such as \"quarter\""
    },
    "%@ s" : {
      "comment" : "Status bar: the take's length in seconds"
    },
    "%@ to %@" : {
      "comment" : "VoiceOver: the keys on show, lowest to highest, e.g. \"C2 to C6\""
    },
    "%@ — %lld notes" : {
      "comment" : "Edit → Versions: a version and its note count, e.g. \"Version 2 — 412 notes\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — %#@notes@"
          },
          "substitutions" : {
            "notes" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg note"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg notes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@%@" : {
      "comment" : "Shown in Recorder+Files, the Transcribe toolbar"
    },
    "%@, %@ note, %@, bar %lld" : {
      "comment" : "VoiceOver: a note or chord in the score, e.g. \"E4 G4, quarter note, Piano, bar 5\"; the second value is a note value such as \"quarter\""
    },
    "%@, %@, bar %lld beat %lld, %@" : {
      "comment" : "VoiceOver: a note on the piano roll; pitch, instrument, where it starts, how long it is, e.g. \"C4, Piano, bar 3 beat 2, half a beat\""
    },
    "%@, bar %lld beat %lld" : {
      "comment" : "VoiceOver: a chord symbol in the chord lane, e.g. \"Am7, bar 3 beat 1\" / VoiceOver: the ruler's value, the playhead's time then its bar and beat"
    },
    "%@, marker at bar %lld" : {
      "comment" : "VoiceOver: a section marker's flag on the ruler, e.g. \"Verse, marker at bar 5\""
    },
    "%lld MB" : {
      "comment" : "A file size in megabytes, e.g. \"618 MB\""
    },
    "%lld added, %lld missing vs %@" : {
      "comment" : "Status bar: notes the transcription has that the compared version lacks, and the reverse"
    },
