            "state" : "translated",
            "value" : "%1$@ — %#@notes@"
          },
          "substitutions" : {
            "notes" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Note"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Noten"
                    }
                  }
                }
              }
            }
