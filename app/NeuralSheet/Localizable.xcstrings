            "state" : "translated",
            "value" : "%@ pulsos"
          }
        }
      }
    },
    "%@ dB" : {
      "comment" : "Accessibility value: a level in decibels, e.g. \"-6.0 dB\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dB"
          }
        },
        "es" : {
          "stringUnit" : {
