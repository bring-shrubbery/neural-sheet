    "%@ (%lld skipped)" : {
      "comment" : "Batch window: a done file, some of whose outputs existed already",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$lld übersprungen)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$lld omitidos)"
          }
        }
      }
    },
    "%@ beats" : {
      "comment" : "VoiceOver: a note's length in beats, to a tenth, e.g. \"1.5 beats\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Schläge"
          }
        },
        "es" : {
