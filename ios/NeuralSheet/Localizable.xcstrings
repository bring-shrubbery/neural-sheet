{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" could not be loaded as a SoundFont (.sf2) or DLS (.dls) file." : {
      "comment" : "Settings → Audio → Sound bank (iOS): a chosen or downloaded file was refused",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als SoundFont- (.sf2) oder DLS-Datei (.dls) geladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido cargar “%@” como archivo SoundFont (.sf2) o DLS (.dls)."
          }
        }
      }
    },
    "%@ GB" : {
      "comment" : "A file size in gigabytes, e.g. \"2.7 GB\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ GB"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ GB"
          }
        }
      }
    },
    "%@ beats" : {
      "comment" : "VoiceOver: a note's length in beats, to a tenth, e.g. \"1.5 beats\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Schläge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pulsos"
          }
        }
      }
    },
    "%@ by %@: free to use and redistribute." : {
      "comment" : "Settings → Sound bank (iOS): the downloadable bank's author and licence in brief",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ von %2$@: darf frei verwendet und weitergegeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ by %2$@: free to use and redistribute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, de %2$@: de uso y redistribución libres."
          }
        }
      }
    },
    "%@ dB" : {
      "comment" : "Accessibility value: a level in decibels, e.g. \"-6.0 dB\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dB"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dB"
          }
        }
      }
    },
    "%@ is for another version of NeuralSheet. Delete it from the models folder, then download it again" : {
      "comment" : "The reason in a failed transcription's alert: the model file is from another release",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gehört zu einer anderen Version von NeuralSheet. Lösche die Datei aus dem Modellordner und lade sie erneut herunter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es de otra versión de NeuralSheet. Elimínalo de la carpeta de modelos y vuelve a descargarlo"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Accessibility value: the playhead's time of the take's length, e.g. \"0:12.34 of 3:05.00\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ von %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@"
          }
        }
      }
    },
    "%@ rest, %@, bar %lld" : {
      "comment" : "VoiceOver: a rest in the score, e.g. \"quarter rest, Piano, bar 5\"; the first value is a note value such as \"quarter\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause (%1$@), %2$@, Takt %3$lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ rest, %2$@, bar %3$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "silencio de %1$@, %2$@, compás %3$lld"
          }
        }
      }
    },
    "%@ to %@" : {
      "comment" : "VoiceOver: the keys on show, lowest to highest, e.g. \"C2 to C6\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bis %2$@"
