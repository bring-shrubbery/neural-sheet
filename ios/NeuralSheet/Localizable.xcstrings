        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@"
          }
        }
      }
    },
    "%@ — %lld notes" : {
      "comment" : "Edit → Versions: a version and its note count, e.g. \"Version 2 — 412 notes\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
