        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, bar %2$lld beat %3$lld"
          }
        }
      }
    },
    "%lld MB" : {
      "comment" : "A file size in megabytes, e.g. \"618 MB\""
