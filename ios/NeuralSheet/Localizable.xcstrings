{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" could not be loaded as a SoundFont (.sf2) or DLS (.dls) file." : {
      "comment" : "Settings → Audio → Sound bank (iOS): a chosen or downloaded file was refused"
    },
    "%@ GB" : {
      "comment" : "A file size in gigabytes, e.g. \"2.7 GB\""
    },
    "%@ beats" : {
      "comment" : "VoiceOver: a note's length in beats, to a tenth, e.g. \"1.5 beats\""
    },
    "%@ by %@: free to use and redistribute." : {
      "comment" : "Settings → Sound bank (iOS): the downloadable bank's author and licence in brief",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ by %2$@: free to use and redistribute."
          }
        }
      }
    },
    "%@ dB" : {
      "comment" : "Accessibility value: a level in decibels, e.g. \"-6.0 dB\""
    },
    "%@ is for another version of NeuralSheet. Delete it from the models folder, then download it again" : {
      "comment" : "The reason in a failed transcription's alert: the model file is from another release"
    },
    "%@ of %@" : {
      "comment" : "Accessibility value: the playhead's time of the take's length, e.g. \"0:12.34 of 3:05.00\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ rest, %@, bar %lld" : {
      "comment" : "VoiceOver: a rest in the score, e.g. \"quarter rest, Piano, bar 5\"; the first value is a note value such as \"quarter\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ rest, %2$@, bar %3$lld"
          }
        }
      }
    },
    "%@ to %@" : {
      "comment" : "VoiceOver: the keys on show, lowest to highest, e.g. \"C2 to C6\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@"
          }
        }
      }
    },
    "%@ — %lld notes" : {
      "comment" : "Edit → Versions: a version and its note count, e.g. \"Version 2 — 412 notes\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$lld notes"
          }
        }
      }
    },
    "%@, %@ note, %@, bar %lld" : {
      "comment" : "VoiceOver: a note or chord in the score, e.g. \"E4 G4, quarter note, Piano, bar 5\"; the second value is a note value such as \"quarter\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ note, %3$@, bar %4$lld"
          }
        }
      }
    },
    "%@, %@, bar %lld beat %lld, %@" : {
      "comment" : "VoiceOver: a note on the piano roll; pitch, instrument, where it starts, how long it is, e.g. \"C4, Piano, bar 3 beat 2, half a beat\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, bar %3$lld beat %4$lld, %5$@"
          }
        }
      }
    },
    "%@, bar %lld beat %lld" : {
      "comment" : "VoiceOver: a chord symbol in the chord lane, e.g. \"Am7, bar 3 beat 1\"\nVoiceOver: the ruler's value, the playhead's time then its bar and beat",
